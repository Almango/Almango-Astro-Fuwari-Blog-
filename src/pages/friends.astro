---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-8 relative w-full">
            <!-- 页面标题 -->
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[var(--primary)]" viewBox="0 0 24 24">
                        <path fill="currentColor" fill-rule="evenodd" d="M5 1a4 4 0 0 0-4 4v14a4 4 0 0 0 4 4h14a4 4 0 0 0 4-4V5a4 4 0 0 0-4-4zm1.91 8.773V7.545A2.545 2.545 0 0 1 9.454 5h3.181c.176 0 .319.142.319.318v2.227A2.546 2.546 0 0 1 15.5 5h3.182c.176 0 .318.142.318.318v2.546a.32.32 0 0 1-.318.318H17.09a.636.636 0 0 0-.637.636v.955h1.591c.176 0 .319.142.319.318v2.227a.32.32 0 0 1-.319.318h-1.59v6.046a.32.32 0 0 1-.319.318h-2.863a.32.32 0 0 1-.319-.318v-6.046H10.41v6.046a.32.32 0 0 1-.318.318H7.227a.32.32 0 0 1-.318-.318v-6.046H5.32a.32.32 0 0 1-.32-.318v-2.227c0-.176.142-.318.318-.318zm6.044 0v-1.91a.32.32 0 0 1-.318.319h-1.59a.636.636 0 0 0-.637.636v.955z" clip-rule="evenodd"/>
                    </svg>
                    <h1 class="text-3xl font-bold text-90">{i18n(I18nKey.friends)}</h1>
                </div>
                <!-- 友链统计 -->
                <p class="text-50 text-sm">
                    共有 <span class="text-[var(--primary)] font-semibold">{friends.length}</span> 位朋友
                </p>
            </div>

            
            <!-- 友链网格 -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
                {friends.map((friend) => (
                    <a href={friend.url} target="_blank" rel="noopener noreferrer" 
                       class="block p-6 rounded-lg bg-[var(--btn-plain-bg-hover)] hover:bg-[var(--btn-regular-bg-hover)] transition-colors duration-200">
                        <div class="flex items-center space-x-4">
                            <div class="flex-shrink-0">
                                <img src={friend.avatar} alt={friend.name} 
                                     class="w-12 h-12 rounded-lg object-cover"
                                     onerror="this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=default'">
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-semibold text-90 truncate hover:text-[var(--primary)] transition-colors duration-200">
                                    {friend.name}
                                </h3>
                                <p class="text-sm text-75 line-clamp-2 mt-1">
                                    {friend.description}
                                </p>
                            </div>
                            <div class="flex-shrink-0">
                                <svg class="w-5 h-5 text-[var(--primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                </svg>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
           
           
           <!-- 友链网格 --><br>
            <div class="mb-12 p-6 rounded-lg bg-[var(--btn-plain-bg-hover)] border-l-4 border-[var(--primary)]">
                <h3 class="text-lg font-semibold mb-3 text-90">友链申请格式</h3>
                <div class="space-y-2 text-75 text-sm">
                    <p><strong>名称：</strong>Almango' Blog</p>
                    <p><strong>描述：</strong>天真永不消逝，浪漫至死不渝。</p>
                    <p><strong>链接：</strong>https://blog.almango.cn/</p>
                    <p><strong>头像：</strong>https://blog.almango.cn/avatar.png</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 评论区 --><br>
    <Comment path="/friends/" />

</MainGridLayout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
